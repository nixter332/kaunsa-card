# Get a key at https://console.anthropic.com and set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EXTRACT_MODEL=claude-sonnet-5-5

# Daily limits on AI lookups (defaults shown)
# AI_DAILY_LIMIT=300
# AI_PER_IP_DAILY_LIMIT=30   (per signed-in person)
# Set automatically when you add Upstash Redis from the Vercel Marketplace:
# UPSTASH_REDIS_REST_URL=   (or KV_REST_API_URL)
# UPSTASH_REDIS_REST_TOKEN= (or KV_REST_API_TOKEN)

# Product analytics (free at posthog.com). Leave empty to send nothing.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com   (or https://us.i.posthog.com)

# Google sign-in (required). From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# AUTH_SECRET: any long random string, e.g. from `npx auth secret`. Use the same value locally and on Vercel.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
